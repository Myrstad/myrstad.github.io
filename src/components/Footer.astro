<section class="footer container">
    <div class="decor">
        <p>morten</p>
        <p>myrstad</p>
    </div>
    <div class="links" id="contact">
        <p>Get in touch!</p>
        <ul>
            <li><a href="https://www.linkedin.com/in/mmyrstad/" target="_blank">LinkedIn</a></li>
            <li><a href="https://github.com/Myrstad" target="_blank">GitHub</a></li>
            <li><a href="mailto:post@mortenmyrstad.no" target="_blank">Email</a></li>
        </ul>
    </div>
</section>

<style>
    .footer {
        margin-top: 164px;
        display: flex;
        justify-content: space-between;

        @media (max-width: 750px) {
            flex-direction: column-reverse;
            gap: 32px;
        }
    }

    .decor {
        --font-size: clamp(80px, 15vw, 224px);

        font-size: 224px;
        font-size: var(--font-size);
        line-height: 90%;
        letter-spacing: -2%;
        display: flex;
        flex-direction: column;
        height: calc(var(--font-size) * 1.4);

        @media (max-width: 750px) {
            --font-size: clamp(80px, 20vw, 224px);
        }

        p {
            font-family: var(--font-display);
            margin: 0;
            text-transform: uppercase;
        }
    }

    .decor p:nth-child(1) {
        color: var(--color-accent);
        opacity: 0.5;
    }

    .decor p:nth-child(2) {
        transform: translateY(-50%);
    }

    .links {
        line-height: 150%;

        p {
            color: var(--color-title);
            font-size: 1.25rem;
            margin: 0;
            padding-bottom: 4px;
        }

        ul {
            padding: 0;
            list-style: none;
            color: var(--color-accent);
            margin: 0;
        }

        a {
            color: inherit;
        }
    }
</style>